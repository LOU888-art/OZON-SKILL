{
  "manifest_version": 3,
  "name": "Northstar 1688 商品采集",
  "version": "0.2.1",
  "description": "在已登录的1688商品页采集可见商品、图片与SKU并发送到Northstar ERP。",
  "permissions": ["activeTab", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://*.1688.com/*"],
  "action": {
    "default_title": "采集1688商品到Northstar ERP",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["main-probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
